```mermaid
graph TB
    subgraph Internet["🌐 Internet / Public Network"]
        SFTP["Legacy SFTP Server<br/>📁 sftp.example.com:22<br/>🔐 Username/Password or SSH Key"]
    end

    subgraph CloudProvider["☁️ Cloud Provider Environment (AWS / GCP / Azure)"]
        subgraph VPC["🏢 Virtual Private Network<br/>(VPC / VPC / VNet)<br/>CIDR: 10.0.0.0/16"]
            
            subgraph PrivateSubnet1["🔒 Private Subnet 1<br/>10.0.1.0/24 | AZ-A"]
                Function["⚡ Serverless Function<br/><br/>AWS: Lambda<br/>GCP: Cloud Functions<br/>Azure: Azure Functions<br/><br/>🐍 Python 3.11<br/>💾 512 MB<br/>⏱️ 300s timeout"]
            end
            
            subgraph PrivateSubnet2["🔒 Private Subnet 2<br/>10.0.2.0/24 | AZ-B<br/>(High Availability)"]
                FunctionHA["⚡ Serverless Function<br/>(HA Instance)"]
            end
            
            RouteTable["🗺️ Route Table<br/><br/>10.0.0.0/16 → Local<br/>Storage → Private Endpoint"]
            
            PrivateEndpoint["🔐 Private Service Endpoint<br/><br/>AWS: VPC Gateway Endpoint (FREE)<br/>GCP: Private Service Connect<br/>Azure: Private Link<br/><br/>💰 No NAT Gateway needed<br/>🔒 Traffic stays in cloud network"]
            
            SecurityGroup["🛡️ Network Security<br/><br/>Egress Rules:<br/>• TCP/443 → Storage (HTTPS)<br/>• TCP/22 → SFTP Server"]
        end
        
        Storage["💾 Object Storage<br/><br/>AWS: S3 Bucket<br/>GCP: Cloud Storage<br/>Azure: Blob Storage<br/><br/>🔐 Encryption: AES-256<br/>📦 Versioning: Enabled<br/>🚫 Public Access: Blocked<br/><br/>Lifecycle Policies:<br/>Day 30: Infrequent Access<br/>Day 90: Archive<br/>Day 180: Deep Archive"]
        
        Secrets["🔑 Secrets Vault<br/><br/>AWS: Secrets Manager<br/>GCP: Secret Manager<br/>Azure: Key Vault<br/><br/>Stores:<br/>• SFTP Host & Port<br/>• Username<br/>• Password/SSH Key"]
        
        IAM["👤 Identity & Access<br/><br/>AWS: IAM Role<br/>GCP: Service Account<br/>Azure: Managed Identity<br/><br/>Permissions (Least Privilege):<br/>• Read Secrets<br/>• Write to Storage<br/>• Write Logs"]
        
        Logging["📊 Logging & Monitoring<br/><br/>AWS: CloudWatch<br/>GCP: Cloud Logging<br/>Azure: Azure Monitor<br/><br/>• Execution logs<br/>• Error traces<br/>• Performance metrics<br/>Retention: 7-30 days"]
        
        Scheduler["⏰ Scheduler<br/><br/>AWS: EventBridge<br/>GCP: Cloud Scheduler<br/>Azure: Logic Apps<br/><br/>Schedule: Daily at 2:00 AM<br/>Triggers: Serverless Function"]
    end

    %% Connections
    SFTP -->|"SSH/SFTP<br/>Port 22<br/>🔐 Encrypted"| Function
    Scheduler -->|"Trigger<br/>cron(0 2 * * *)"| Function
    Function -->|"1️⃣ Get Credentials"| Secrets
    Function -->|"2️⃣ HTTPS via Private Endpoint<br/>Port 443"| PrivateEndpoint
    PrivateEndpoint -->|"3️⃣ Private Connection"| Storage
    Function -->|"4️⃣ Write Logs"| Logging
    IAM -.->|"Authorize"| Function
    SecurityGroup -.->|"Protect"| Function
    RouteTable -->|"Route Traffic"| PrivateEndpoint
    PrivateSubnet1 --> RouteTable
    PrivateSubnet2 --> RouteTable
    FunctionHA -.->|"Redundancy"| Function

    %% Styling
    classDef awsStyle fill:#FF9900,stroke:#232F3E,stroke-width:2px,color:#232F3E
    classDef gcpStyle fill:#4285F4,stroke:#1a73e8,stroke-width:2px,color:#fff
    classDef azureStyle fill:#0078D4,stroke:#0053a6,stroke-width:2px,color:#fff
    classDef securityStyle fill:#d63384,stroke:#a71d5d,stroke-width:2px,color:#fff
    classDef networkStyle fill:#6f42c1,stroke:#563d7c,stroke-width:2px,color:#fff
    classDef storageStyle fill:#28a745,stroke:#1e7e34,stroke-width:2px,color:#fff
    
    class Function,FunctionHA,Scheduler awsStyle
    class Secrets,IAM securityStyle
    class VPC,PrivateSubnet1,PrivateSubnet2,PrivateEndpoint,RouteTable,SecurityGroup networkStyle
    class Storage,Logging storageStyle
```

