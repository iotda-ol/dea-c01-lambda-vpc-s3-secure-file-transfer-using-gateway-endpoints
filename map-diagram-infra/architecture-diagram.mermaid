    S1 --> S2
    S1 --> S3
    
    C1 --> SE1
    C1 --> SE2
    S1 --> SE3
    N4 --> SE4
    N2 --> SE5
    
    C1 --> O1
    C1 --> O2
    C1 --> O3
    
    OR1 --> C1
